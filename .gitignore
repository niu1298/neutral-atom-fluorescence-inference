# ---------------------------------------------------------------- raw data
# Raw experimental shots stay local. They are never committed.
Experiment-Data/
experiment-data/

# ------------------------------------------------------- derived local data
# Processed tables are reproducible from the raw shots; not committed until a
# publication decision has been made explicitly.
data/processed/
data/interim/

# Generated reports hold unreduced experimental figures -> local only. Every
# number they contain that is meant to be public is quoted in docs/ or in
# reports/readme_metrics.md, which IS tracked.
reports/qc/
reports/audit/
reports/validation/

# ------------------------------------------------------------ local machine
# Real machine paths live here; only the .example file is committed.
configs/local.toml
configs/*.local.yaml

# ---------------------------------------------------------------- artefacts
assets/readme/frames/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
_scratch/
logs/

# ------------------------------------------------------------------- editor
.vscode/
.idea/
.DS_Store
Thumbs.db
